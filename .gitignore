__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
.pytest_cache/
.coverage
.coverage.*
.env
.claude/settings.local.json

# Reportes de cobertura
# `htmlcov/` (suite completa) es regenerable y NO se versiona.
# `htmlcov-unit/` y `coverage-unit.xml` SÍ se versionan: son la evidencia del
# >= 80 % de la capa unitaria que se entrega con la presentación.
htmlcov/
coverage.xml

# Material del video de presentación: solo se versiona el video final (el guion queda local).
video/*
!video/*.mp4

# Tooling de git hooks (Husky + lint-staged)
node_modules/

# Claves privadas (key pair de AWS EC2): nunca al repo
*.pem
*.ppk
