root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# YAML forbids tabs: keep spaces here
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Trailing double space is a line break in Markdown
[*.md]
trim_trailing_whitespace = false
